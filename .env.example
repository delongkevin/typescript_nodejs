# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# AWS (optional - falls back to local file storage if not provided)
AWS_REGION=us-east-1
AWS_S3_BUCKET=wireless-workbench-backups
AWS_DYNAMODB_TABLE=wireless-workbench-devices
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Storage backend: 'memory' | 'file' | 'aws'
STORAGE_BACKEND=file
DATA_DIR=./data
